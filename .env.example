# ============================================================================
# Deep Research ADK — environment configuration
# Copy to .env and fill in. The system reads .env automatically.
# ============================================================================

# ---- Google AI / Gemini ----
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Tell ADK to use the Gemini API directly (not Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ---- Model tier ----
# Strong reasoning models for Manager / Planner / Critic / Writer.
# Cheap fast model for parallel Researchers (this is the Anthropic pattern:
# big brains decide and synthesize, small fast workers execute).
DR_MODEL_MANAGER=gemini-2.5-pro
DR_MODEL_PLANNER=gemini-2.5-pro
DR_MODEL_WRITER=gemini-2.5-pro
DR_MODEL_CRITIC=gemini-2.5-flash
DR_MODEL_RESEARCHER=gemini-2.5-flash

# ---- Search backend (SearXNG, self-hosted) ----
# Point this at your running SearXNG instance.
# Example: http://localhost:8081
SEARXNG_BASE_URL=http://localhost:8081

# ---- Research budget ----
# Caps that keep the system from running forever. Tune as you wish.
DR_MAX_SUBQUESTIONS=8
DR_MAX_RESEARCH_ROUNDS=3
DR_MAX_PARALLEL_RESEARCHERS=4
DR_MAX_SEARCHES_PER_SUBQUESTION=6
DR_MIN_SOURCES_PER_SUBQUESTION=2
DR_MIN_SOURCE_TIER=3       # 1=peer-reviewed, 2=gov/official, 3=major news, 4=industry, 5=blog/forum

# ---- Workspace storage ----
# SQLite DB that holds every project's structured workspace. Survives restarts.
DR_WORKSPACE_DB=./dr_workspace.db
